# All settings are optional; these are the defaults.

# Vector DB backend: "qdrant" or "chroma"
VECTOR_DB=qdrant
QDRANT_PATH=./data/qdrant
CHROMA_PATH=./data/chroma
COLLECTION_NAME=pdf_chunks

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CACHE_DIR=./data/models

# Chunk length in characters (chosen with scripts/evaluate.py)
CHUNK_SIZE=800
CHUNK_OVERLAP=160

DEFAULT_TOP_K=5

# Answer generation: local LLM served by Ollama (https://ollama.com)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b
ANSWER_TOP_K=3
LLM_MAX_TOKENS=300
ANSWER_MIN_SCORE=0.4

SQLITE_PATH=./data/documents.db
MAX_UPLOAD_MB=20
